# Required for Claude-powered narration and rules answers
ANTHROPIC_API_KEY=sk-ant-...

# Cloud Storage bucket for PDFs, Chroma, and saves (Cloud Run)
# AUTO_DM_BUCKET=celssi-auto-dm
# ALLOWED_EMAILS=lauri.mukkala.fi@gmail.com
# FIREBASE_PROJECT_ID=celssi

# Chat model for the DM pipeline (default: claude-opus-5-5)
CLAUDE_CHAT_MODEL=claude-opus-5-5

# Optional: local Ollama chat fallback (not used when Anthropic key is set)
# OLLAMA_CHAT_MODEL=gemma3:12b

# Optional: cross-encoder reranking model for RAG
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: Ollama request timeout in seconds (embeddings / ingest)
# OLLAMA_REQUEST_TIMEOUT=600

# Optional: LangSmith tracing for LangGraph / LangChain (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=Auto DM Tracing Project
